{
	"services": {
		"frontend": {
			"root": "frontend",
			"framework": "vite",
			"buildCommand": "npm run build",
			"outputDirectory": "dist",
			"rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
		},
		"backend": {
			"root": "backend",
			"framework": "express",
			"entrypoint": "src/index.ts",
			"buildCommand": "npm run generate"
		},
		"cron": {
			"root": "cron"
		}
	},
	"rewrites": [
		{
			"source": "/api/cron(/.*)?",
			"destination": { "type": "service", "service": "cron" }
		},
		{
			"source": "/api(/.*)?",
			"destination": { "type": "service", "service": "backend" }
		},
		{
			"source": "/(.*)",
			"destination": { "type": "service", "service": "frontend" }
		}
	],
	"crons": [
		{
			"path": "/api/cron/recalculate-ratings",
			"schedule": "0 3 * * *"
		}
	]
}
